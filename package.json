{
  "name": "gearlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env=dev -- next dev",
    "build": "next build",
    "start": "infisical run --env=dev -- next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "infisical run --env=dev -- prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:deploy": "infisical run --env=dev -- prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
