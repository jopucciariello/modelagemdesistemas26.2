# Variables the app needs. Their values live in Infisical, environment "dev" (ADR-003):
# register each key there; do not create a .env file. Run commands via the npm scripts,
# which wrap them in `infisical run --env=dev --`. See README "Como executar".

# SQLite database file (relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Public URL of the app (used to build redirects)
APP_URL="http://localhost:3000"

# Strava API application (https://www.strava.com/settings/api)
# "Authorization Callback Domain" in Strava must be: localhost
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_CALLBACK_URL="http://localhost:3000/auth/strava/callback"
STRAVA_API_BASE_URL="https://www.strava.com/api/v3"
STRAVA_OAUTH_BASE_URL="https://www.strava.com/oauth"
STRAVA_WEBHOOK_VERIFY_TOKEN=""

# Admin login with Google (ADR-002). Create an OAuth client ID of type "Web application"
# at https://console.cloud.google.com/apis/credentials with this authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Comma-separated Google e-mails allowed into /admin (RB17)
ADMIN_EMAILS=""

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
