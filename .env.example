# Variables the app needs. Their values live in Infisical, environment "dev" (ADR-003):
# register each key there; do not create a .env file. Run commands via the npm scripts,
# which wrap them in `infisical run --env=dev --`. See README "Como executar".

# SQLite database file (relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Public URL of the app (used to build redirects)
APP_URL="http://localhost:3000"

# Strava (ADR-006): there is no app-wide Strava app. Each athlete registers their own and pastes
# the Client ID/Secret in the app (stored encrypted). Both are optional overrides, used only in tests.
# STRAVA_OAUTH_BASE_URL="https://www.strava.com/oauth"
# STRAVA_CALLBACK_URL="http://localhost:3000/auth/strava/callback"   # default: APP_URL + /auth/strava/callback

# Login with Google for every profile (ADR-005). Create an OAuth client ID of type "Web application"
# at https://console.cloud.google.com/apis/credentials with this authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Comma-separated Google e-mails that become admins and can open /admin (RB17)
ADMIN_EMAILS=""

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
STRAVA_API_BASE_URL=
